# Public (peut être exposé au navigateur)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ROOT_DOMAIN=e-mairie.example
NEXT_PUBLIC_DEFAULT_MUNICIPALITY=niankorodougou

# SERVEUR UNIQUEMENT — ne jamais préfixer par NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
TRACKING_SECRET_PEPPER=
PAYMENT_MODE=sandbox            # sandbox | live (live : aucun prestataire n'est intégré à ce jour)
SANDBOX_WEBHOOK_SECRET=         # 32+ caractères aléatoires ; requis pour le mode sandbox
CRON_SECRET=                    # 32+ caractères ; protège /api/cron/sms, /api/cron/payments et /api/cron/purge
REQUIRE_AGENT_MFA=0             # 1 = authentification à deux facteurs (TOTP) obligatoire pour les agents (à activer après test réel)
CHROMIUM_EXECUTABLE_PATH=       # PDF : chemin du binaire Chromium
# CHROMIUM_NO_SANDBOX=1         # conteneurs exécutés en root uniquement
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_WEBHOOK_SECRET=
MOOV_MONEY_API_KEY=
MOOV_MONEY_WEBHOOK_SECRET=
SMS_MODE=test                   # test | live
SMS_PROVIDER_API_KEY=
